#!/usr/bin/env bash
set -euo pipefail
network=bridge
if [[ "${1:-}" == --network ]]; then
    if [[ $# -ne 3 || ! "$2" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
        echo 'Usage: ./bin/test [--network NETWORK] URL' >&2
        exit 2
    fi
    network="$2"
    shift 2
fi
if [[ $# -ne 1 || ! "$1" =~ ^https?:// ]]; then
    echo 'Usage: ./bin/test [--network NETWORK] URL' >&2
    exit 2
fi
source "$(dirname "${BASH_SOURCE[0]}")/lib/runner"
run_container "$network" test "$1"
