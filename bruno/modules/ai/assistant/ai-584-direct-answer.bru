meta {
  name: Assistant answers without capabilities
  type: http
  seq: 584
}

post {
  url: {{baseUrl}}{{assistantPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {"message": "Reply with a short greeting."}
}

script:pre-request {
  bru.setVar("kind", "assistant");
  bru.setVar("expectedCode", "");
  bru.setVar("expectedStatus", 200);
  bru.setVar("expectedCapabilities", "");
}

settings {
  followRedirects: false
  timeout: 2000
}
