meta {
  name: Assistant uses one READ capability
  type: http
  seq: 585
}

post {
  url: {{baseUrl}}{{assistantPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {"message": "List the available units of measure."}
}

script:pre-request {
  bru.setVar("kind", "assistant");
  bru.setVar("expectedCode", "");
  bru.setVar("expectedStatus", 200);
  bru.setVar("expectedCapabilities", "wms.uoms.list");
}

settings {
  followRedirects: false
  timeout: 2000
}
