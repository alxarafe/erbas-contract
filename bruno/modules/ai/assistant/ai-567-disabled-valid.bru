meta {
  name: Disabled AI rejects valid request
  type: http
  seq: 567
}

post {
  url: {{baseUrl}}{{assistantPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {"message": "Reply with a short greeting."}
}

script:pre-request {
  bru.setVar("kind", "assistant");
  bru.setVar("expectedStatus", 503);
  bru.setVar("expectedCode", "module_disabled");
}

settings {
  followRedirects: false
  timeout: 2000
}
