meta {
  name: Authenticated user without AI permission
  type: http
  seq: 564
}

post {
  url: {{baseUrl}}{{assistantPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{userToken}}
  Content-Type: application/json
}

body:json {
  {"message": "Reply with a short greeting."}
}

script:pre-request {
  bru.setVar("kind", "assistant");
  bru.setVar("expectedCode", "");
  bru.setVar("expectedStatus", 403);
}

settings {
  followRedirects: false
  timeout: 2000
}
