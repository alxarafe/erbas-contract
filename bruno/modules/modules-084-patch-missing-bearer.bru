meta {
  name: Modules patch-missing-bearer
  type: http
  seq: 84
}

patch {
  url: {{baseUrl}}{{modulesPath}}/{{moduleBaseIdPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {"enabled":true}
}

script:pre-request {
  bru.setVar("moduleBaseIdPath", encodeURIComponent(bru.getVar("moduleBaseId")));
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 401
  responseKind: error
}
