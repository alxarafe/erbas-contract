meta {
  name: Storage Attributes numeric-first-code
  type: http
  seq: 231
}

post {
  url: {{baseUrl}}{{storageAttributesPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  const input = {code: "1A", name: "Each"}; req.setBody(input);
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 400
  responseKind: error
  expectedCode: invalid_request
}
