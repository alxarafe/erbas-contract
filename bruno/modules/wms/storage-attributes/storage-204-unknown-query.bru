meta {
  name: Storage Attributes unknown-query
  type: http
  seq: 204
}

get {
  url: {{baseUrl}}{{storageAttributesPath}}?sort=code
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 400
  responseKind: error
  expectedCode: invalid_request
}
