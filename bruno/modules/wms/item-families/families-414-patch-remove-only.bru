meta {
  name: WMS-003 patch-remove-only
  type: http
  seq: 414
}

patch {
  url: {{baseUrl}}{{itemFamiliesPath}}/{{wms003FamilyId}}/{{associationSegment}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  const masters = bru.getVar("wms003Masters") || [];
  const family = bru.getVar("wmsItemFamilies")[0];
  const state = bru.getVar("wms003Relation") || [];
  const value = key => bru.getFolderVar(key);
  bru.setVar("wms003FamilyId", family.id);
  bru.setVar("wms003NextRelation",state.filter(value => value.id!==masters[2].id));
  req.setBody({remove:[masters[2].id]});
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 204
  responseKind: empty
}
