meta {
  name: WMS-003 patch-existence-before-conflicts
  type: http
  seq: 404
}

patch {
  url: {{baseUrl}}{{itemFamiliesPath}}/{{wms003FamilyId}}/{{associationSegment}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  const masters = bru.getVar("wms003Masters") || [];
  const family = bru.getVar("wmsItemFamilies")[0];
  const value = key => bru.getFolderVar(key);
  const absent = value("absentAttribute");
  const otherAbsent = value("anotherAbsentAttribute");
  const detail = (code, resource, resourceId, path) => ({code: value(code), resource: value(resource), resourceId, ...(path ? {path} : {})});
  const error = (code, details) => bru.setVar("wms003ExpectedError", {code: value(code), errors: details});
  bru.setVar("wms003FamilyId", family.id);
  error("resourcesMissing",[detail("attributeMissing","attributeResource",absent,"/add/1"),detail("attributeMissing","attributeResource",otherAbsent,"/remove/0")]);
  req.setBody({add:[masters[1].id,absent],remove:[otherAbsent,masters[0].id]});
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 404
  responseKind: error
}
