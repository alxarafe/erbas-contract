meta {
  name: WMS-003 relation-spanish
  type: http
  seq: 420
}

get {
  url: {{baseUrl}}{{itemFamiliesPath}}/{{wms003FamilyId}}/{{associationSegment}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Accept-Language: es
}

script:pre-request {
  const family = bru.getVar("wmsItemFamilies")[0];
  bru.setVar("wms003FamilyId", family.id);

}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 200
  responseKind: relation-collection
  expectedOffset: 0
  expectedLimit: 50
}
