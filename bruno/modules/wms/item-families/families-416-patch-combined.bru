meta {
  name: WMS-003 patch-combined
  type: http
  seq: 416
}

patch {
  url: {{baseUrl}}{{itemFamiliesPath}}/{{wms003FamilyId}}/{{associationSegment}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  const masters = bru.getVar("wms003Masters") || [];
  const family = bru.getVar("wmsItemFamilies")[0];
  bru.setVar("wms003FamilyId", family.id);
  bru.setVar("wms003NextRelation",[masters[1],masters[2]]);
  req.setBody({add:[masters[2].id],remove:[masters[0].id]});
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 204
  responseKind: empty
}
