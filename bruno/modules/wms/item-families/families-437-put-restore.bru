meta {
  name: WMS-003 put-restore
  type: http
  seq: 437
}

put {
  url: {{baseUrl}}{{itemFamiliesPath}}/{{wms003FamilyId}}/{{associationSegment}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  const masters = bru.getVar("wms003Masters") || [];
  const family = bru.getVar("wmsItemFamilies")[0];
  const value = key => bru.getFolderVar(key);
  bru.setVar("wms003FamilyId", family.id);
  bru.setVar("wms003NextRelation",masters);
  req.setBody({storageAttributeIds:masters.map(value=>value.id)});
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 204
  responseKind: empty
}
