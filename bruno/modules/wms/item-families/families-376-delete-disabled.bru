meta {
  name: WMS-003 delete-disabled
  type: http
  seq: 376
}

delete {
  url: {{baseUrl}}{{itemFamiliesPath}}/bad/{{associationSegment}}/bad
  body: none
  auth: none
}

headers {
  Accept: application/json
