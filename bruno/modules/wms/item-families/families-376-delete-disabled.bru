}

script:pre-request {
  const family = bru.getVar("wmsItemFamilies")[0];
  bru.setVar("wms003FamilyId", family.id);

}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 503
  responseKind: error
  expectedCode: module_disabled
}
