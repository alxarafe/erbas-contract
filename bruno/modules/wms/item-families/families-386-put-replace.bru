meta {
  name: WMS-003 put-replace
  type: http
  seq: 386
}

put {
  url: {{baseUrl}}{{itemFamiliesPath}}/{{wms003FamilyId}}/{{associationSegment}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  const masters = bru.getVar("wms003Masters") || [];
  const family = bru.getVar("wmsItemFamilies")[0];
  bru.setVar("wms003FamilyId", family.id);
  bru.setVar("wms003NextRelation",[masters[2],masters[1]]);
  req.setBody({storageAttributeIds:[masters[2].id,masters[1].id]});
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 204
  responseKind: empty
}
