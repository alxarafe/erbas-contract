meta {
  name: Capabilities 515 normal-hidden
  type: http
  seq: 515
}

get {
  url: {{baseUrl}}{{capabilitiesPath}}?offset={{capOffset}}&limit={{maximumLimit}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{userToken}}
}

script:pre-request {
  bru.setVar("capOffset", bru.getVar("capNextOffset") || 0);
  if (!bru.getVar("capOffset")) bru.setVar("capSeen", []);
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 200
  kind: collection
  requestName: Capabilities 515 normal-hidden
  wmsVisible: false
}
