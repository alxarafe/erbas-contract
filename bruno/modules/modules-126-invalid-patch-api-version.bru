meta {
  name: Modules invalid-patch-api-version
  type: http
  seq: 126
}

patch {
  url: {{baseUrl}}{{modulesPath}}/{{moduleBaseIdPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {"enabled":true,"moduleApiVersion":1}
}

script:pre-request {
  bru.setVar("moduleBaseIdPath", encodeURIComponent(bru.getVar("moduleBaseId")));
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 400
  responseKind: error
}
