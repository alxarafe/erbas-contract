meta {
  name: Modules excessive-limit
  type: http
  seq: 100
}

get {
  url: {{baseUrl}}{{modulesPath}}?limit=101
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 400
  responseKind: error
}
