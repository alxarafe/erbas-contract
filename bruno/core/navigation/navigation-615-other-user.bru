meta {
  name: Navigation other-user
  type: http
  seq: 615
}

get {
  url: {{baseUrl}}/api/meta/navigation
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{userToken}}
  If-None-Match: {{navigationEtag}}
}

vars:pre-request {
  expectedStatus: 200
}

settings {
  followRedirects: false
  timeout: 2000
}

tests {
  test("other-user navigation semantics",function(){
    expect(res.getHeader("etag")).not.to.equal(bru.getVar("navigationEtag"));
  });
}
