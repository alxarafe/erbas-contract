meta {
  name: Navigation unchanged
  type: http
  seq: 614
}

get {
  url: {{baseUrl}}/api/meta/navigation
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  If-None-Match: {{navigationEtag}}
}

vars:pre-request {
  expectedStatus: 304
}

settings {
  followRedirects: false
  timeout: 2000
}

tests {
  test("unchanged navigation semantics",function(){
    expect(res.getHeader("etag")).to.equal(bru.getVar("navigationEtag"));
  });
}
