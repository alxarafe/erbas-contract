}

vars:pre-request {
  expectedStatus: 400
}

settings {
  followRedirects: false
  timeout: 2000
}

body:json {
  {}
}

script:pre-request {
  req.setBody({target:{id:bru.getVar("probeRecord")},parameters:{__unknown:true}});
}
