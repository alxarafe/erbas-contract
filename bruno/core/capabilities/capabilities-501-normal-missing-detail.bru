  Authorization: Bearer {{userToken}}
}

script:pre-request {
  bru.setVar("capOffset", bru.getVar("capOffset") || 0);
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 404
  kind: error
  requestName: Capabilities 501 normal-missing-detail
}
