meta {
  name: Capabilities 503 negative-offset
  type: http
  seq: 503
}

get {
  url: {{baseUrl}}{{capabilitiesPath}}?offset=-1
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
}

script:pre-request {
  bru.setVar("capOffset", bru.getVar("capOffset") || 0);
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 400
  kind: error
  requestName: Capabilities 503 negative-offset
}
