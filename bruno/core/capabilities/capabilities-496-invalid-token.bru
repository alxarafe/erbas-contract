meta {
  name: Capabilities 496 invalid-token
  type: http
  seq: 496
}

get {
  url: {{baseUrl}}{{capabilitiesPath}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{invalidCapabilityToken}}
}

script:pre-request {
  bru.setVar("capOffset", bru.getVar("capOffset") || 0);
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 401
  kind: error
  requestName: Capabilities 496 invalid-token
}
