meta {
  name: Capabilities 502 invalid-id
  type: http
  seq: 502
}

get {
  url: {{baseUrl}}{{capabilitiesPath}}/invalid
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
}

script:pre-request {
  bru.setVar("capOffset", bru.getVar("capOffset") || 0);
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 400
  kind: error
  requestName: Capabilities 502 invalid-id
}
