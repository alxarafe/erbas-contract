meta {
  name: Capabilities 508 detail-query
  type: http
  seq: 508
}

get {
  url: {{baseUrl}}{{capabilitiesPath}}/absent.resource.read?limit=1
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
}

script:pre-request {
  bru.setVar("capOffset", bru.getVar("capOffset") || 0);
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 400
  kind: error
  requestName: Capabilities 508 detail-query
}
