meta {
  name: Modules probe-math-disable-after-conflict
  type: http
  seq: 115
}

patch {
  url: {{baseUrl}}{{modulesPath}}/{{moduleMathIdPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {"enabled":false}
}

script:pre-request {
  bru.setVar("moduleMathIdPath", encodeURIComponent(bru.getFolderVar("MATH_ID")));
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 200
  responseKind: module
  fixture: math
  expectedEnabled: false
}
