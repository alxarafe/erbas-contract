meta {
  name: Modules invalid-patch-malformed
  type: http
  seq: 129
}

patch {
  url: {{baseUrl}}{{modulesPath}}/{{moduleMathIdPath}}
  body: text
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:text {
  {"enabled":
}

script:pre-request {
  bru.setVar("moduleMathIdPath", encodeURIComponent(bru.getFolderVar("MATH_ID")));
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 400
  responseKind: error
}
