meta {
  name: Modules patch-non-admin
  type: http
  seq: 89
}

patch {
  url: {{baseUrl}}{{modulesPath}}/{{moduleMathIdPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{userToken}}
  Content-Type: application/json
}

body:json {
  {"enabled":true}
}

script:pre-request {
  bru.setVar("moduleMathIdPath", encodeURIComponent(bru.getFolderVar("MATH_ID")));
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 403
  responseKind: error
}
