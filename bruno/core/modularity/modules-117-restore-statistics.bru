meta {
  name: Modules restore-statistics
  type: http
  seq: 117
}

patch {
  url: {{baseUrl}}{{modulesPath}}/{{moduleStatisticsIdPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {"enabled":true}
}

script:pre-request {
  bru.setVar("moduleStatisticsIdPath", encodeURIComponent(bru.getFolderVar("STATISTICS_ID")));
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 200
  responseKind: module
  fixture: statistics
  expectedEnabled: true
}
