meta {
  name: WMS create-single-character
  type: http
  seq: 143
}

post {
  url: {{baseUrl}}{{uomsPath}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
  Content-Type: application/json
}

body:json {
  {}
}

script:pre-request {
  const input = {code: "M", description: " X "}; bru.setVar("wmsInput", input); req.setBody(input);
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 201
  responseKind: uom
}
