meta {
  name: WMS offset-window
  type: http
  seq: 146
}

get {
  url: {{baseUrl}}{{uomsPath}}?offset=1&limit=1
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{adminToken}}
}

settings {
  followRedirects: false
  timeout: 2000
}

vars:pre-request {
  expectedStatus: 200
  responseKind: collection
  expectedOffset: 1
  expectedLimit: 1
}
